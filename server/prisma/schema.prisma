generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}

model Question {
  id            String        @id       @default(uuid())
  media         String   
  tags          Tag[]
  answerId      String
  answer        Answer        @relation(fields: [answerId], references: [id])
}

model Tag {
  id          String        @id       @default(uuid())
  name        String        @unique
  category    String
  questions   Question[]
  set         Set[]
}

model Answer {
  id            String        @id       @default(uuid())
  value         String        @unique
  answerTypeId  String
  answerType    AnswerType    @relation(fields: [answerTypeId], references: [id])
  questions     Question[]
}

model AnswerType {
  id          String        @id       @default(uuid())
  name        String        @unique
  answer      Answer[]
}

model Set {
  id          String        @id       @default(uuid())
  name        String
  tags        Tag[]
}