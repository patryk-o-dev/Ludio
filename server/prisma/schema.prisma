generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}

model Question {
  id            String        @id       @default(uuid())
  media         String   
  tags          Tag[]
  used          Boolean       @default(false)
  answerId      String
  answer        Answer        @relation(fields: [answerId], references: [id])
  answerTypeId  String
  answerType    AnswerType    @relation(fields: [answerTypeId], references: [id])
}

model Tag {
  id          String        @id       @default(uuid())
  name        String        @unique
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  lvl         Int           @default(0)
  unlocked    Boolean       @default(false)
  questions   Question[]
  setGuess    Set[]         @relation("SetGuess")
  setBy       Set[]         @relation("SetBy")
  setOnly     Set[]         @relation("SetOnly")
  setWithout  Set[]         @relation("SetWithout")
}

model Answer {
  id            String        @id       @default(uuid())
  value         String        @unique
  answerTypeId  String
  answerType    AnswerType    @relation(fields: [answerTypeId], references: [id])
  questions     Question[]
}

model AnswerType {
  id          String        @id       @default(uuid())
  name        String        @unique
  answer      Answer[]
  question    Question[]
}

model Set {
  id            String        @id       @default(uuid())
  name          String
  option        Option?
  guess         Tag[]         @relation("SetGuess")
  by            Tag[]         @relation("SetBy")
  only          Tag[]         @relation("SetOnly")
  without       Tag[]         @relation("SetWithout")
  unlocked      Boolean       @default(false)
  selected      Boolean       @default(false)
  done          Boolean       @default(false)
  perfect       Boolean       @default(false)
}

model Option {
  id                  String        @id       @default(uuid())
  numberOfQuestions   Int
  scoreNeeded         Int
  expEarned           Int
  setId               String        @unique
  set                 Set           @relation(fields: [setId], references: [id])
}

model Category {
  id          String      @id       @default(uuid())
  name        String      @unique
  lvl         Int         @default(0)
  lvlMax      Int         @default(10)
  maxed       Boolean     @default(false)
  expNeeded   Int         @default(1)
  expAdded    Int         @default(0)
  tags        Tag[]
}

model Player {
  id            String        @id           @default(uuid())
  exp           Int           @default(0)
  questionIndex Int           @default(0)
  score         Int           @default(0)
}