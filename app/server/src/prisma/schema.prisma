generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum GameSessionPlayerStatus {
  Invited
  Accepted
  Declined
  Answering
  Completed
  Left
}

enum GameSessionStatus {
  NotStarted
  InProgress
  Completed
}

model User {
  id        String   @id @default(uuid())
  username  String   @db.VarChar(64)
  createdAt DateTime @default(now())

  sessions GameSessionPlayer[]
  questions Question[]
}

model GameConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  gameSession GameSession?
  rules       Rule[]
  options     Options?
}

model GameSession {
  id        String   @id @default(uuid())
  startedAt DateTime @default(now())
  endedAt   DateTime?
  status    GameSessionStatus @default(NotStarted)
  qIndex    Int @default(0)

  usedQuestions Question[]

  gameConfigId String     @unique
  gameConfig   GameConfig @relation(fields: [gameConfigId], references: [id])

  players GameSessionPlayer[]
}

model GameSessionPlayer {
  gameSessionId String
  userId        String

  score  Int @default(0)
  timeMs Int @default(0)
  rank   Int @default(0)
  status GameSessionPlayerStatus @default(Invited)

  gameSession GameSession @relation(fields: [gameSessionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@id([gameSessionId, userId])
}

model Options {
  id String @id @default(uuid())

  gameConfigId String     @unique
  gameConfig   GameConfig @relation(fields: [gameConfigId], references: [id])

  difficulty       Int @default(1)
  questionLimit    Int @default(10)
  timeLimitSeconds Int?
}

model Rule {
  id          String @id @default(uuid())
  description String?

  gameConfigId String
  gameConfig   GameConfig @relation(fields: [gameConfigId], references: [id])

  chipGuessId String
  chipGuess   ChipGuess @relation(fields: [chipGuessId], references: [id])

  chipById String
  chipBy   ChipBy @relation(fields: [chipById], references: [id])

  chipFilters ChipFilter[]
}

model ChipGuess {
  id   String @id @default(uuid())
  name String

  rules    Rule[]
  questions Question[]
  answers  Answer[]

  compatibleChipBy ChipBy[]
}

model ChipBy {
  id   String @id @default(uuid())
  name String

  rules     Rule[]
  questions Question[]

  compatibleChipGuess  ChipGuess[]
  compatibleChipFilter ChipFilter[]
}

model ChipFilter {
  id   String @id @default(uuid())
  name String

  rules     Rule[]
  questions Question[]
  answers   Answer[]

  compatibleChipBy ChipBy[]
}

model Question {
  id String @id @default(uuid())

  url String
  difficulty Int @default(1)

  answerId String
  answer Answer @relation(fields: [answerId], references: [id])

  chipById String
  chipBy ChipBy @relation(fields: [chipById], references: [id])

  chipGuesses ChipGuess[]
  chipFilters ChipFilter[]
  usedInSessions GameSession[]

  users User[]
}

model Answer {
  id    String @id @default(uuid())
  value String

  chipGuesses ChipGuess[]
  chipFilters ChipFilter[]

  questions Question[]
}

