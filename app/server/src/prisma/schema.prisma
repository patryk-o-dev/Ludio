generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum GameSessionPlayerStatus {
  Invited
  Accepted
  Declined
  Answering
  Completed
  Left
}

enum GameSessionStatus {
  NotStarted
  InProgress
  Completed
}

enum InviteStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum GameSessionType {
  PRIVATE
  COMMUNITY
}

enum GameMode {
  CLASSIC
  SOLO
  LEAGUE_OF_LEGENDS
  DEAD_BY_DAYLIGHT
}

model User {
  id                  String   @id @default(uuid())
  username            String   @db.VarChar(64)
  twitchId            String?  @unique @db.VarChar(64)
  displayName         String?  @db.VarChar(64)
  avatarUrl           String?  @db.VarChar(512)
  createdAt           DateTime @default(now())
  allowFriendRequests Boolean  @default(true)

  sentFriendships     Friendship[] @relation("InviteFrom")
  receivedFriendships Friendship[] @relation("InviteTo")

  ownedCommunity Community?
  communities    CommunityMember[]

  sessions  GameSessionPlayer[]
  questions Question[]
}

model Friendship {
  id         String @id @default(uuid())
  fromUserId String
  toUserId   String

  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  fromUser User @relation("InviteFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("InviteTo", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
}

model GameConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  gameSession GameSession?
  rules       Rule[]
  options     Options?
}

model GameSession {
  id        String            @id @default(uuid())
  status    GameSessionStatus @default(NotStarted)
  qIndex    Int               @default(0)
  hostId    String
  type      GameSessionType   @default(PRIVATE)
  startedAt DateTime          @default(now())
  endedAt   DateTime?

  usedQuestions Question[]

  gameConfigId String     @unique
  gameConfig   GameConfig @relation(fields: [gameConfigId], references: [id], onDelete: Cascade)

  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])

  players GameSessionPlayer[]
}

model GameSessionPlayer {
  gameSessionId String
  userId        String

  score  Int                     @default(0)
  timeMs Int                     @default(0)
  rank   Int                     @default(0)
  status GameSessionPlayerStatus @default(Invited)

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@id([gameSessionId, userId])
}

model Options {
  id               String @id @default(uuid())
  gameConfigId     String @unique
  difficulty       Int    @default(1)
  questionLimit    Int    @default(10)
  timeLimitSeconds Int?

  gameConfig GameConfig @relation(fields: [gameConfigId], references: [id], onDelete: Cascade)
}

model Rule {
  id           String  @id @default(uuid())
  description  String?
  gameConfigId String
  chipGuessId  String
  chipById     String

  gameConfig GameConfig @relation(fields: [gameConfigId], references: [id], onDelete: Cascade)
  chipGuess  ChipGuess  @relation(fields: [chipGuessId], references: [id])
  chipBy     ChipBy     @relation(fields: [chipById], references: [id])

  chipFilters ChipFilter[]
}

model ChipGuess {
  id   String   @id @default(uuid())
  key  String   @unique
  name String
  mode GameMode

  rules     Rule[]
  questions Question[]
  answers   Answer[]

  compatibleChipBy ChipBy[]
}

model ChipBy {
  id   String @id @default(uuid())
  key  String @unique
  name String

  rules     Rule[]
  questions Question[]

  compatibleChipGuess  ChipGuess[]
  compatibleChipFilter ChipFilter[]
}

model ChipFilter {
  id   String @id @default(uuid())
  key  String @unique
  name String

  rules     Rule[]
  questions Question[]
  answers   Answer[]

  compatibleChipBy ChipBy[]
}

model Question {
  id         String @id @default(uuid())
  key        String @unique
  url        String
  difficulty Int    @default(1)
  answerId   String
  chipById   String

  answer Answer @relation(fields: [answerId], references: [id])
  chipBy ChipBy @relation(fields: [chipById], references: [id])

  chipGuesses    ChipGuess[]
  chipFilters    ChipFilter[]
  usedInSessions GameSession[]

  users User[]

  achievement QuestionAchievement?
  credits     String?
}

model QuestionAchievement {
  id               String @id @default(uuid())
  questionId       String @unique
  achievementTitle String
  achievementDesc  String

  question Question @relation(fields: [questionId], references: [id])
}

model Answer {
  id      String  @id @default(uuid())
  key     String  @unique
  value   String
  valuePl String?

  chipGuesses ChipGuess[]
  chipFilters ChipFilter[]

  questions Question[]
}

model Community {
  id String @id @default(uuid())

  ownerId String            @unique
  owner   User              @relation(fields: [ownerId], references: [id])
  members CommunityMember[]

  createdAt    DateTime      @default(now())
  gameSessions GameSession[]
}

model CommunityMember {
  communityId String
  userId      String

  joinedAt DateTime @default(now())

  points Int @default(0)

  gamesPlayed Int @default(0)

  community Community @relation(fields: [communityId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([communityId, userId])
}
